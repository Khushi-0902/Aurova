# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored, so your keys never get committed.
#
# In production (Vercel), set the SAME variables under:
#   Project → Settings → Environment Variables
# ---------------------------------------------------------------------------

# --- Supabase (content: properties + marketing) ----------------------------
# From Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Required for cross-device wishlist sync (server-side reads/writes of saved
# homes). NEVER expose this to the browser and NEVER prefix it with NEXT_PUBLIC_.
# If it's absent, the wishlist quietly falls back to per-browser storage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email one-time-code sign-in (Resend) ----------------------------------
# From https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key
# The "from" address. It MUST be on a domain you've verified in Resend
# (https://resend.com/domains). Leave it UNSET to use Resend's sandbox sender,
# which only delivers to your own Resend account email — fine for testing.
# RESEND_FROM=Aurova <noreply@aurovaliving.in>

# --- Google sign-in (already working) ---------------------------------------
# AUTH_GOOGLE_ID=...
# AUTH_GOOGLE_SECRET=...
